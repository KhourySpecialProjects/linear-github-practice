<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.classList.add('js');</script>
<title>{% block title %}{{ site.title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ site.tagline or site.title }}{% endblock %}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='8'%20fill='%237c5cff'/%3E%3Ctext%20x='16'%20y='23'%20text-anchor='middle'%20font-family='ui-sans-serif,system-ui,sans-serif'%20font-size='19'%20font-weight='700'%20fill='%23ffffff'%3EB%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="/assets/style.css">
<script src="/assets/app.js" defer></script>
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
  <div class="wrap topbar__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{{ site.title }}</span>
    </a>
    <p class="topbar__count">
      <strong>{{ stats.bios }}</strong> {{ 'bio' if stats.bios == 1 else 'bios' }}
      <span class="topbar__sep" aria-hidden="true">/</span>
      <span class="topbar__teams">{{ stats.teams }} of {{ stats.total_teams }} teams</span>
    </p>
  </div>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__note">{{ site.footer }}</p>
    <p class="footer__built">Rebuilt on every merge &middot; <time datetime="{{ built_at.isoformat() }}">{{ built_at_label }}</time></p>
    {% block footer_extra %}{% endblock %}
  </div>
</footer>
</body>
</html>
